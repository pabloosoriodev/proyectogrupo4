# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.
# Las variables del proceso tienen prioridad sobre .env.
# En AWS estos valores vendrán de Parameter Store (ADR-0010); aquí solo desarrollo local.

# PostgreSQL 16 local (servicio Windows postgresql-x64-16). Base y usuario: db/setup-local.sql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comparador_dev
DB_USER=comparador_app
# Contraseña de desarrollo solo local (la misma que se pasa a db/setup-local.sql)
DB_PASSWORD=
# true exige SSL a PostgreSQL (obligatorio en RDS, ADR-0003); false en local
DB_SSL=false
# Tiempo máximo para conectar y para la consulta de salud, en ms
DB_CONNECT_TIMEOUT_MS=3000

# API local (npm run dev:api)
API_PORT=3000
# Origen de la web autorizado por CORS (cabecera Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Web (Vite): URL base de la API
VITE_API_URL=http://localhost:3000

# HU-01 — scraping diario (npm run scrape:local)
# Ruta a un JSON con este formato (en AWS el mismo JSON va en Parameter Store,
# /comparador/{entorno}/comercios):
# { "comercios": [ { "slug": "wong", "nombre": "Wong", "activo": true,
#                    "url": "https://www.wong.pe", "tipo": "json",
#                    "limitePeticionesPorSegundo": 2 } ],
#   "busquedas": ["leche", "arroz", "azúcar", "atún", "aceite"],
#   "maxResultadosPorBusqueda": 100 }
# maxResultadosPorBusqueda (obligatorio, entero > 0): tope de resultados por término y comercio.
COMERCIOS_CONFIG_PATH=
# Intentos en total por comercio (1 + reintentos), ADR-0011
SCRAPING_MAX_INTENTOS=3
# Tiempo máximo por petición a la web de un comercio, en ms
SCRAPING_TIMEOUT_MS=10000
# User-Agent con el que se identifica el scraper (también decide el grupo de robots.txt)
SCRAPING_USER_AGENT=
# Archivo JSON Lines de la DLQ local
SCRAPING_DLQ_LOCAL_PATH=
